{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "autoCompactWindow": 250000,
  "showClearContextOnPlanAccept": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/orient.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git push -u origin claude/batch-*)",
      "Bash(git push origin claude/batch-*)"
    ]
  }
}
