{
  "name": "brainrottcg",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/preview-pages.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.scripts.json",
    "preview": "vite preview",
    "test": "vitest run --coverage --testTimeout=15000",
    "test:browser": "playwright test",
    "cards": "tsx scripts/cards/build.ts",
    "cards:finish-thumbs": "tsx scripts/cards/build-finish-thumbs.ts",
    "check:card-assets": "tsx scripts/check-card-assets.ts",
    "check:sets": "tsx scripts/check-sets.ts",
    "check:site": "tsx scripts/check-site.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:sets && npm run check:card-assets",
    "prompts": "tsx scripts/cards/prompts.ts",
    "og-image": "tsx scripts/og-image.ts",
    "icons": "tsx scripts/logo-icons.ts",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:performance:optional-work": "playwright test --config=playwright.optional-work.config.ts",
    "audit:agent": "tsx scripts/agent-audit/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.34.3",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.56.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "26.1.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
